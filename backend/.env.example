PORT=8080
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
ELDERCARE_AUTH_MODE=pin
ELDERCARE_SESSION_SECRET=change-me-to-a-long-random-secret
PORTAL_TOKEN_SECRET=change-me-to-a-separate-long-random-secret
ELDERCARE_SESSION_HOURS=12
ELDERCARE_DEMO_AUTH=false
ELDERCARE_CORS_ORIGINS=http://localhost:8080,http://localhost:8081
ELDERCARE_PUBLIC_BASE_URL=http://localhost:8080
ELDERCARE_API_RATE_LIMIT_MAX=600
ELDERCARE_AUTH_RATE_LIMIT_MAX=30
ELDERCARE_PORTAL_RATE_LIMIT_MAX=240
ELDERCARE_AI_INBOUND_RATE_LIMIT_MAX=180
ELDERCARE_PAYMENT_EVIDENCE_BUCKET=payment-evidence
ELDERCARE_AI_WEBHOOK_SECRET=change-me-before-real-provider-webhooks
ELDERCARE_AI_ANALYSIS_URL=
ELDERCARE_AI_ANALYSIS_SECRET=
AI_ANALYSIS_TIMEOUT_MS=8000
ELDERCARE_OUTBOUND_DELIVERY_URL=
ELDERCARE_OUTBOUND_DELIVERY_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- อุ่นใจ Care Platform (customer/caregiver portals, /api/v1) ---
# JWT signing secret for portal access tokens (separate from ERP session secret)
CARE_JWT_SECRET=change-me-to-a-long-random-secret-for-care-portals
# AES-256-GCM key material for sensitive-at-rest fields (id card numbers)
CARE_ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key
# Private storage bucket for caregiver documents / photos (signed URL <= 15 min)
CARE_DOCUMENTS_BUCKET=care-documents
# Rate limits for the care portals
CARE_AUTH_RATE_LIMIT_MAX=30
CARE_API_RATE_LIMIT_MAX=600
# SMS provider for OTP: "mock" logs the OTP in dev (DECISIONS.md 2026-06-11)
CARE_SMS_PROVIDER=mock

# Optional: override PDF Thai font for non-macOS deployment.
# Use *_FACE only for TTC font collections.
ELDERCARE_PDF_FONT_PATH=
ELDERCARE_PDF_BOLD_FONT_PATH=
ELDERCARE_PDF_FONT_FACE=
ELDERCARE_PDF_BOLD_FONT_FACE=

# Payment gateway: "mock" (default, dev) or "omise" (needs keys below)
CARE_PAYMENT_GATEWAY=mock
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
